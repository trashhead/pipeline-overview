{
  "manifestVersion": 1,
  "id": "pipeline-overview",
  "publisher": "ViktorEriksson",
  "version": "0.1.5",
  "name": "CI/CD Overview",
  "description": "Overview of pipelines, runs and stage status per environment. Read-only: it never starts, changes or approves anything.",
  "categories": [
    "Azure Pipelines"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": [
    "vso.build",
    "vso.project"
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images/icon.png",
      "addressable": true
    },
    {
      "path": "images/screenshot-1.png",
      "addressable": true
    },
    {
      "path": "LICENSE",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "cicd-dashboard-hub",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-build-web.build-release-hub-group"
      ],
      "properties": {
        "name": "CI/CD Overview",
        "uri": "dist/index.html",
        "order": 50
      }
    }
  ],
  "icons": {
    "default": "images/icon.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "tags": [
    "pipelines",
    "dashboard",
    "ci",
    "cd",
    "deployments"
  ],
  "repository": {
    "type": "git",
    "uri": "https://github.com/trashhead/pipeline-overview"
  },
  "links": {
    "repository": {
      "uri": "https://github.com/trashhead/pipeline-overview"
    },
    "issues": {
      "uri": "https://github.com/trashhead/pipeline-overview/issues"
    },
    "support": {
      "uri": "https://github.com/trashhead/pipeline-overview/issues"
    }
  }
}
