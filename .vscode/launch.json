{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dashboard (Vite dev server + browser)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "Local:\s+(https?://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}"
      }
    }
  ]
}
